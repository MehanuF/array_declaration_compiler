/*
 * lexer.l  —  Lex/Flex specification for the Array Declaration Compiler
 * Member 2 — Lexical Analyzer
 *
 * Compile:
 *   flex -o lex_yacc/lex.yy.c lex_yacc/lexer.l
 *
 * Token rules:
 *   - Keywords : int, float, char
 *   - Identifier: letter/underscore followed by letters/digits/underscores
 *   - Integer literal: one or more digits
 *   - Operators: = + - * / [ ] { } ( ) , ;
 *   - Whitespace and newlines are skipped
 *   - Single-line (//) and block comments are skipped
 */

%{
#include "parser.tab.h"   /* token codes generated by bison */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int line_num = 1;          /* track current line for error messages */
%}

/* ── Flex options ─────────────────────────────────────────────── */
%option noyywrap
%option yylineno

/* ── Pattern definitions ──────────────────────────────────────── */
DIGIT       [0-9]
LETTER      [a-zA-Z_]
ALNUM       [a-zA-Z0-9_]

%%

    /* ── Whitespace — skip ──────────────────────────────────── */
[ \t\r]+        { /* skip spaces and tabs */ }
\n              { line_num++; }

    /* ── Single-line comment — skip ────────────────────────── */
"//"[^\n]*      { /* skip to end of line */ }

    /* ── Block comment — skip ──────────────────────────────── */
"/*"([^*]|\*+[^*/])*\*+"/"  { /* skip block comment */ }

    /* ── Keywords ──────────────────────────────────────────── */
"int"           { return TOK_INT;   }
"float"         { return TOK_FLOAT; }
"char"          { return TOK_CHAR;  }

    /* ── Identifier ─────────────────────────────────────────── */
{LETTER}{ALNUM}* {
                  yylval.str = strdup(yytext);
                  return TOK_ID;
                }

    /* ── Integer literal ────────────────────────────────────── */
{DIGIT}+        {
                  yylval.ival = atoi(yytext);
                  return TOK_INT_LITERAL;
                }

    /* ── Operators and delimiters ───────────────────────────── */
"="             { return TOK_ASSIGN;    }
"+"             { return TOK_PLUS;      }
"-"             { return TOK_MINUS;     }
"*"             { return TOK_MULTIPLY;  }
"/"             { return TOK_DIVIDE;    }
"["             { return TOK_LBRACKET; }
"]"             { return TOK_RBRACKET; }
"{"             { return TOK_LBRACE;   }
"}"             { return TOK_RBRACE;   }
"("             { return TOK_LPAREN;   }
")"             { return TOK_RPAREN;   }
","             { return TOK_COMMA;    }
";"             { return TOK_SEMICOLON;}

    /* ── Unknown character — error ──────────────────────────── */
.               {
                  fprintf(stderr,
                      "Lexical Error [line %d]: unknown character '%s'\n",
                      line_num, yytext);
                }

%%
